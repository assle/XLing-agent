AGENT_FRAMEWORK=langgraph
AI_PROVIDER=mock
AI_MAX_TOKENS=2048
# 实际联调使用远程回答模型和本地风险分类器。
# 直接运行 Python 时使用 localhost；在 Docker 中使用 host.docker.internal。
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CLASSIFIER_MODEL=xling-cls-3b-ft:latest
# 仅在可选的本地回答模式 AI_PROVIDER=ollama 下使用。
OLLAMA_MODEL=xling-qwen2.5-7b-ft:latest
FINETUNED_MODEL_NAME=xling-qwen2.5-7b-ft:latest
FINETUNED_MODEL_DIR=models/xling-qwen2.5-7b-ft
FINETUNED_MODEL_FILE=xling-qwen2.5-7b-ft-q4_k_m.gguf
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Embedding can use a separate provider (e.g. DeepSeek chat + OpenAI embedding)
# Leave empty to fall back to OPENAI_BASE_URL / OPENAI_API_KEY
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# DeepSeek: set AI_PROVIDER=openai, then configure below (OpenAI-compatible, no code change needed)
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
# To use DeepSeek, set:
#   AI_PROVIDER=openai
#   OPENAI_BASE_URL=https://api.deepseek.com/v1
#   OPENAI_API_KEY=your_deepseek_api_key
#   OPENAI_MODEL=deepseek-chat
#   KNOWLEDGE_VECTOR_REQUIRED=false  (DeepSeek has no embeddings API, falls back to local hybrid search)
DATABASE_URL=mysql+pymysql://xling:xling@127.0.0.1:3306/xling?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_MEMORY_TTL_SECONDS=86400
REDIS_MEMORY_MAX_MESSAGES=40
REDIS_SOCKET_TIMEOUT_SECONDS=2
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
KNOWLEDGE_TOP_K=4
KNOWLEDGE_VECTOR_ENABLED=true
KNOWLEDGE_VECTOR_REQUIRED=false
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION_NAME=xling_knowledge
EMBEDDING_TIMEOUT_SECONDS=30
RAG_EVAL_ENABLED=false
RAG_EVAL_EXIT_AFTER_RUN=false
# Self-contained eval: SQLite engine + isolated Chroma store (no MySQL/Docker).
# Set OPENAI_API_KEY above + pip install chromadb to run the true vector baseline;
# without them the runner falls back to local hybrid_score and warns.
RAG_EVAL_DATABASE_URL=sqlite:///data/rag-eval.db
RAG_EVAL_CHROMA_PERSIST_DIR=data/chroma-eval
RAG_EVAL_CHROMA_COLLECTION_NAME=xling_knowledge_eval
RAG_EVAL_BASELINE_OUTPUT=target/rag-eval-baseline.json
# RAG eval strategies (issues 02-04): multi-query, hybrid-RRF, LLM-rerank
RAG_EVAL_MULTI_QUERY_OUTPUT=target/rag-eval-multi-query.json
RAG_EVAL_HYBRID_RRF_OUTPUT=target/rag-eval-hybrid-rrf.json
RAG_EVAL_LLM_RERANK_OUTPUT=target/rag-eval-llm-rerank.json
RAG_EVAL_RERANK_CANDIDATE_POOL=20
RAG_EVAL_MULTI_QUERY_COUNT=3
RAG_EVAL_RRF_K=60
RAG_EVAL_AI_PROVIDER=mock
# Risk eval (issue 02): set to openai to use real LLM
RISK_EVAL_DATASET=app/risk_eval/xling-risk-eval.json
RISK_EVAL_OUTPUT=target/risk-eval-report.json
RISK_EVAL_SUMMARY_OUTPUT=target/risk-eval-summary.json
RISK_EVAL_AI_PROVIDER=mock
# Quality eval (issue 04): set gen/judge providers to openai to use real LLM
QUALITY_EVAL_DATASET=app/quality_eval/xling-quality-eval.json
QUALITY_EVAL_OUTPUT=target/quality-eval-report.json
QUALITY_EVAL_SUMMARY_OUTPUT=target/quality-eval-summary.json
QUALITY_EVAL_GEN_PROVIDER=mock
QUALITY_EVAL_GEN_TEMPERATURE=0.3
QUALITY_EVAL_JUDGE_PROVIDER=openai
QUALITY_EVAL_JUDGE_MODEL=gpt-4o
QUALITY_EVAL_JUDGE_BASE_URL=https://api.openai.com/v1
QUALITY_EVAL_JUDGE_API_KEY=
QUALITY_EVAL_JUDGE_TEMPERATURE=0.0
QUALITY_EVAL_JUDGE_RUNS=3
TOOL_QUEUE_ENABLED=true
TOOL_QUEUE_POLL_INTERVAL_SECONDS=1
TOOL_QUEUE_BATCH_SIZE=10
TOOL_QUEUE_MAX_ATTEMPTS=3
TOOL_QUEUE_RETRY_DELAY_SECONDS=15
TOOL_QUEUE_EXCEL_WORKERS=1
TOOL_QUEUE_EMAIL_WORKERS=2
ALERT_EMAIL_RATE_LIMIT_PER_MINUTE=30
ALERT_EMAIL_DELIVERY_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_EMAIL_SUBJECT_PREFIX=[Xling 高风险预警]
# Security: bcrypt + JWT (issue 01)
BCRYPT_ROUNDS=12
JWT_SECRET_KEY=xling-dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
