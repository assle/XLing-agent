# 本机部署只在这里填写必需项和确实需要覆盖的配置；不要提交真实密钥。
# 稳定应用默认值由 app/core/config.py 的 Settings 提供，无需复制到本文件。
DOMAIN=localhost
CADDY_EMAIL=internal
AI_PROVIDER=mock
JWT_SECRET_KEY=xling-dev-secret-change-in-production

# 本机 Docker 与 DBeaver 共用以下 MySQL 配置；Compose 自动生成容器内的 DATABASE_URL。
MYSQL_DATABASE=xling
MYSQL_USER=xling
MYSQL_PASSWORD=xling
MYSQL_ROOT_PASSWORD=root
# 仅绑定本机回环地址；DBeaver 使用 127.0.0.1 和此端口连接。
MYSQL_PORT=3306

# 当前生成式分类器联调选择；同时供应用回退和 Ollama 模型注册使用。
OLLAMA_CLASSIFIER_MODEL=xling-general-cls-05b:quoted-f16
# 使用 --profile models 启动 Ollama；容器内地址由 Compose 提供。
# OLLAMA_IMAGE=docker.1ms.run/ollama/ollama:0.1.48
# CLASSIFIER_BACKEND=ollama
# 决策头模型包固定包含 base/、adapter/、head.pt、calibration.json、system-prompt.txt。
# DECISION_HEAD_BUNDLE_DIR=models/xling-decision-head

# 远程回答服务：取消注释并填写同一 OpenAI 兼容服务的配置。
# AI_PROVIDER=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# 向量服务留空时复用回答服务地址和密钥，也可单独覆盖。
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=

# 可选的本地回答模式。
# AI_PROVIDER=ollama
# OLLAMA_MODEL=xling-qwen2.5-7b-ft:latest

# 其他可选应用覆盖示例；未设置的值继续跟随 Settings 默认值。
# AI_MAX_TOKENS=4096
# KNOWLEDGE_VECTOR_ENABLED=false
# ALERT_EMAIL_DELIVERY_MODE=log

# 迁移说明：旧的五个 DECISION_HEAD_* 路径统一迁移为 DECISION_HEAD_BUNDLE_DIR；
# 应用调参和评测输出无需复制，确实需要覆盖时仍使用 Settings 支持的同名变量。
# SERVER_HOST / SERVER_PORT 是进程启动参数，不是共享应用模板配置：
# SERVER_HOST=0.0.0.0 SERVER_PORT=8080 ./scripts/run-dev.sh
