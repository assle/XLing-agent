# 生产部署只填写必需项和确实需要覆盖的配置；不要提交真实密钥。
ENVIRONMENT=production
DOMAIN=your-domain.com
CADDY_EMAIL=your-email@example.com
JWT_SECRET_KEY=change-this-to-a-random-32-plus-char-string

# 生产模式拒绝开发默认密码；数据库名和普通用户名未覆盖时沿用 Compose 默认值。
MYSQL_ROOT_PASSWORD=change-this
MYSQL_PASSWORD=change-this
# MYSQL_DATABASE=xling
# MYSQL_USER=xling

# 使用同一 OpenAI 兼容回答服务；其他生成上限和安全参数跟随 Settings 默认值。
AI_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt4o-mini

# 可选：覆盖默认生成式分类器时，必须同时匹配模型定义和输入契约。
# OLLAMA_CLASSIFIER_MODEL=xling-general-cls-05b:quoted-f16
# OLLAMA_CLASSIFIER_MODEL=Modelfile.quoted-f16
# CLASSIFIER_INPUT_FORMAT=quoted
# 纯 Ollama 部署可避免重复尝试加载决策头；决策头产物路径用 DECISION_HEAD_BUNDLE_DIR 单独覆盖。
# CLASSIFIER_BACKEND=ollama

# 可选：独立向量服务；留空时复用回答服务地址和密钥。
# EMBEDDING_BASE_URL=
# EMBEDD_API_KEY=

# 可选：SMTP 通知。未配置时沿用 Settings 的 log 投递模式。
# ALERT_EMAIL_DELIVERY_MODE=smtp
# SMTP_HOST=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# ALERT_EMAIL_FROM=
# ALERT_EMAIL_TO=

# 配置职责和旧变量迁移见 docs/docker-operations.md。