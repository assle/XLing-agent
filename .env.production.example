# Required
DOMAIN=your-domain.com
CADDY_EMAIL=your-email@example.com
JWT_SECRET_KEY=change-this-to-a-random-32-plus-char-string

# Database
MYSQL_ROOT_PASSWORD=change-this
MYSQL_PASSWORD=change-this
MYSQL_USER=xling
MYSQL_DATABASE=xling

# AI Provider
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=xling-qwen2.5-7b-ft:latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Security
BCRYPT_ROUNDS=12
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Email alerts (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_EMAIL_DELIVERY_MODE=log

# Knowledge
KNOWLEDGE_VECTOR_ENABLED=true
KNOWLEDGE_VECTOR_REQUIRED=false
